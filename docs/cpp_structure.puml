@startuml cpp_structure
title YOLO ROS C++ Logic Flow

start

partition "Lifecycle: on_configure()" {
  :Init CameraManager;
  :Init Visualizer;
  :Detector->load();
  :Init Estimator & Tracker;
}

partition "Lifecycle: on_activate()" {
  :CameraManager->configure() & activate();
  :Visualizer->setup_publishers();
  :Create Timer;
}

partition "timer_callback()" {
  
  :CameraManager->gather_images();
  if (No new data?) then (Yes)
    :Return;
  endif

  partition "Inference" {
    :Detector->detect(images);
  }
  
  partition "Process Detections" {
    while (For each camera data?)
      :Select depth & info;
      while (For each detection?)
        :Estimator->compute_3d(result, depth, info);
        note right: Deprojection & Sampling
      endwhile
    endwhile
  }

  partition "Tracking" {
     :Tracker->process(d3d_list, tf_buffer, ...);
     note right: Merging & Temporal Filtering
  }
  
  :Publish Detections;
  
  if (publish_annotated?) then (Yes)
    :Visualizer->publish_annotated_images();
  endif

}

stop

@enduml
