@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "yolo_ros_cpp" {

    ' --- Główny Node ROS ---
    class YoloDetectNode {
        -- Lifecycle --
        +on_configure(state: State) : CallbackReturn
        +on_activate(state: State) : CallbackReturn
        +on_deactivate(state: State) : CallbackReturn
        +on_cleanup(state: State) : CallbackReturn
        +on_shutdown(state: State) : CallbackReturn
        
        -- Callbacks --
        -on_camera_data(color, depth, info, camera_index)
        -timer_callback()
        
        -- Members --
        -detector: unique_ptr<IDetector>
        -estimator: unique_ptr<PositionEstimator>
        -tracker: unique_ptr<DetectionTracker>
        
        -tf_buffer: shared_ptr<Buffer>
        -tf_listener: shared_ptr<TransformListener>
        
        -cameras_: vector<shared_ptr<CameraContext>>
        -params: (num_cameras, publish_annotated, etc.)
    }

    struct CameraContext {
        +index: int
        +color_sub: shared_ptr<SimpleFilter<Image>>
        +depth_sub: shared_ptr<SimpleFilter<Image>>
        +info_sub: shared_ptr<Subscriber<CameraInfo>>
        +sync: shared_ptr<Synchronizer>
        +annotated_pub: shared_ptr<Publisher>
        +has_new_data: bool
    }
    
    class CompressedSubscriberWrapper {
        +CompressedSubscriberWrapper(node, topic, qos)
        -sub_: Subscription<CompressedImage>
        -signalMessage(image: Image)
    }

    ' --- Warstwa Inferencji (niezależna od ROS) ---
    interface IDetector {
        +{abstract} load(model_path: string, config: Config) : bool
        +{abstract} detect(images: vector<cv::Mat>) : vector<vector<Result2D>>
    }

    class YoloOpenCVDetector {
        +load(model_path: string, config: Config) : bool
        +detect(images: vector<cv::Mat>) : vector<vector<Result2D>>
        -net : cv::dnn::Net
    }

    struct Result2D {
        +id: int
        +class_id: int
        +score: float
        +bbox: cv::Rect
    }

    ' --- Warstwa Obliczeń 3D (niezależna od bibliotek ML) ---
    class PositionEstimator {
        +set_parameters(class_radii: map<int, float>)
        +compute_3d(detection: Result2D, depth: cv::Mat, info: CameraModel) : Detection3D
        
        -sample_depth_from_region(...)
        -estimate_from_radius(...)
        -project_pixel_to_3d(...)
    }
    
    struct Detection3D {
        +result2d: Result2D
        +position: geometry_msgs::Point
        +header: std_msgs::Header
    }

    ' --- Warstwa Logiki Biznesowej i Śledzenia ---
    class DetectionTracker {
        +update(new_detections: vector<Detection3D>, tf_buffer: Buffer, target_frame: string) : vector<Detection3D>
        
        -transform_to_world(...)
        -spatial_merge(detections)
        -temporal_filter(detections)
        
        -history: map<int, DetectionGroup>
    }

    class DetectionGroup {
        +add_measurement(det: Detection3D)
        +is_confirmed() : bool
        +get_state() : Detection3D
        -measurements: deque<Detection3D>
    }
}

' Relacje
YoloDetectNode *-- IDetector
YoloDetectNode *-- PositionEstimator
YoloDetectNode *-- DetectionTracker
YoloDetectNode *-- CameraContext : manages many
CameraContext ..> CompressedSubscriberWrapper : uses for compressed

IDetector <|.. YoloOpenCVDetector
IDetector ..> Result2D : produces

PositionEstimator ..> Result2D : uses
PositionEstimator ..> Detection3D : produces

DetectionTracker *-- DetectionGroup
DetectionTracker ..> Detection3D : processes

@enduml